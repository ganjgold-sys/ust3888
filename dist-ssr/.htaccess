# Единый адрес: HTTPS и без www
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://ust38.ru%{REQUEST_URI} [L,R=301]

  # Существующие файлы и папки отдаются как есть (/tsena-bankrotstva/ → её index.html)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Всё остальное — ошибка 404, а не главная с кодом 200.
  # Раньше здесь стоял фолбэк на /index.html: любой несуществующий адрес
  # отдавал главную с кодом 200, и поисковик индексировал бесконечные копии.
  RewriteRule ^ - [R=404,L]
</IfModule>

# Страница ошибки. Отдаётся вместе с настоящим кодом 404.
ErrorDocument 404 /404.html

# Точка входа для папок
DirectoryIndex index.html

# Кеширование статики
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>

# Сжатие текстовых ресурсов
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Не кешировать HTML: контент меняется, а хешированных имён у него нет
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

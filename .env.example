# GEMINI_API_KEY: ключ для ИИ-консультанта (необязательно)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: адрес, где размещён сайт
APP_URL="https://ust38.ru"

# ─────────────────────────────────────────────────────────────
# ПОЧТА ДЛЯ ЗАЯВОК С САЙТА
#
# Без этих настроек форма покажет ошибку и НЕ примет заявку.
# Письма с заявками уходят на MAIL_TO.
#
# Пример для Яндекс.Почты:
#   SMTP_HOST=smtp.yandex.ru
#   SMTP_PORT=465
#   SMTP_USER=you@yandex.ru
#   SMTP_PASS=пароль_приложения   (НЕ обычный пароль,
#                 создаётся: id.yandex.ru → Безопасность → Пароли приложений)
#
# Пример для Mail.ru: SMTP_HOST=smtp.mail.ru, SMTP_PORT=465
# Пример для Gmail:   SMTP_HOST=smtp.gmail.com, SMTP_PORT=465
#                 (нужен пароль приложения из аккаунта Google)
# ─────────────────────────────────────────────────────────────
SMTP_HOST="smtp.yandex.ru"
SMTP_PORT="465"
SMTP_USER="you@yandex.ru"
SMTP_PASS="app-password-here"

# Куда присылать заявки. Можно несколько адресов через запятую.
MAIL_TO="Dovod38@gmail.com"

# От чьего имени отправлять. Обычно совпадает с SMTP_USER.
MAIL_FROM="you@yandex.ru"
